{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "strict": false,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.mjs", "scripts/**/*.mjs", "assets/js/app.js", "types.d.ts"],
  "exclude": ["**/node_modules/**"]
}
